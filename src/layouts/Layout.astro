---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-[#07090E] text-[#F7F0E6]">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Smash-It Sam - Hand Cut Zabiha Halal Smash Burgers & Live Catering"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/SmashItSamLogo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@500;700;800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body
    class="bg-[#07090E] text-[#F7F0E6] font-['Inter',sans-serif] selection:bg-[#7A1515] selection:text-white min-h-screen flex flex-col justify-between m-0"
  >
    <slot />
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  h1,
  h2,
  h3,
  h4,
  .font-syne {
    font-family: "Syne", sans-serif;
  }
</style>
