---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Smash-It Sam | Hand Cut Zabiha Halal Smash Burgers">
  <!-- Header / Nav -->
  <header
    class="w-full py-5 px-6 md:px-12 flex items-center justify-between border-b border-white/10 backdrop-blur-md sticky top-0 z-50 bg-[#07090E]/90"
  >
    <div class="flex items-center gap-3">
      <img
        src="/SmashItSamLogo.png"
        alt="Smash-It Sam Logo"
        class="w-12 h-12 rounded-full object-cover border-2 border-[#7A1515]"
      />
      <span class="font-syne font-bold text-xl tracking-wider text-white"
        >SMASH-IT SAM</span
      >
    </div>
    <div class="flex items-center gap-4">
      <a
        href="#catering"
        class="hidden sm:inline-block text-sm font-semibold tracking-wide text-white/80 hover:text-white transition"
        >Catering</a
      >
      <a
        href="https://cash.app/$smashitsam"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#7A1515] hover:bg-[#921919] text-white px-5 py-2.5 rounded-full font-syne font-bold text-sm tracking-wider shadow-lg shadow-[#7A1515]/30 transition transform hover:-translate-y-0.5"
      >
        ORDER ONLINE
      </a>
    </div>
  </header>

  <!-- Hero Section -->
  <main class="flex-grow">
    <section
      class="relative min-h-[85vh] flex items-center justify-center px-6 py-16 overflow-hidden"
    >
      <!-- Background Glows -->
      <div
        class="absolute -top-40 -left-40 w-96 h-96 bg-[#7A1515]/20 rounded-full blur-3xl pointer-events-none"
      >
      </div>
      <div
        class="absolute bottom-0 right-0 w-96 h-96 bg-[#7D95D1]/10 rounded-full blur-3xl pointer-events-none"
      >
      </div>

      <div
        class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10"
      >
        <!-- Left Column: Copy & CTAs -->
        <div class="text-center lg:text-left space-y-6">
          <div
            class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#7A1515]/20 border border-[#7A1515]/40 text-[#F7F0E6] text-xs font-semibold tracking-widest uppercase"
          >
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"
            ></span>
            100% Hand Cut Zabiha Halal
          </div>

          <h1
            class="font-syne font-extrabold text-4xl sm:text-6xl lg:text-7xl tracking-tight leading-tight text-white"
          >
            CRISPY EDGES. <br />
            <span class="text-white">JUICY PATTIES.</span>
          </h1>

          <p
            class="text-lg text-white/70 max-w-xl mx-auto lg:mx-0 font-normal leading-relaxed"
          >
            Unapologetically messy, perfectly smashed burgers made with premium
            hand-cut Zabiha Halal ingredients. Order online instantly or book us
            for your next live event.
          </p>

          <div
            class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-4"
          >
            <a
              href="https://cash.app/$smashitsam"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto text-center bg-[#7A1515] hover:bg-[#921919] text-white px-7 py-4 rounded-xl font-syne font-bold text-sm tracking-wider shadow-xl shadow-[#7A1515]/40 transition transform hover:-translate-y-0.5 whitespace-nowrap"
            >
              ORDER ONLINE
            </a>
            <a
              href="#catering"
              class="w-full sm:w-auto text-center bg-white/5 hover:bg-white/10 border border-white/15 text-white px-7 py-4 rounded-xl font-syne font-bold text-sm tracking-wider transition whitespace-nowrap"
            >
              BOOK PRIVATE CATERING
            </a>
          </div>
        </div>

        <!-- Right Column: Single Combined Video Reel -->
        <div class="relative flex justify-center">
          <div
            class="relative w-full max-w-md rounded-3xl overflow-hidden shadow-2xl border border-white/10 group bg-[#07090E]"
          >
            <div
              class="absolute inset-0 bg-gradient-to-t from-[#07090E] via-transparent to-transparent opacity-40 z-10 pointer-events-none"
            >
            </div>

            <video
              id="hero-video"
              src="/process.mp4"
              autoplay
              muted
              loop
              playsinline
              class="w-full h-[420px] sm:h-[480px] object-cover object-[center_70%]"
            >
              Your browser does not support the video tag.
            </video>

            <div
              class="absolute bottom-4 left-4 right-4 z-20 bg-[#07090E]/80 backdrop-blur-md p-4 rounded-2xl border border-white/10 flex items-center justify-between"
            >
              <div>
                <p class="font-syne font-bold text-white text-sm">
                  Real Flat-Top Action
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Catering Section with Netlify Form -->
    <section
      id="catering"
      class="py-24 px-6 relative border-t border-white/10 bg-[#0A0D14]"
    >
      <div class="max-w-3xl mx-auto">
        <div class="text-center space-y-4 mb-12">
          <span
            class="text-[#D1B89F] font-syne font-bold text-sm tracking-widest uppercase"
            >LIVE EVENT EXPERIENCE</span
          >
          <h2 class="font-syne font-extrabold text-4xl sm:text-5xl text-white">
            BOOK PRIVATE CATERING
          </h2>
          <p class="text-white/70 max-w-lg mx-auto text-base">
            Want us to bring our live flat-top setup to your birthday,
            graduation, or special occasion? Fill out the form below and we'll
            get right back to you.
          </p>
        </div>

        <div
          class="bg-[#101420] p-8 sm:p-10 rounded-3xl border border-white/10 shadow-2xl relative"
        >
          <!-- Success Message Alert -->
          <div
            id="form-success"
            class="hidden mb-6 p-4 rounded-xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 text-center font-syne text-sm font-semibold"
          >
            🎉 Thank you! Your catering request has been submitted. We'll be in
            touch soon!
          </div>

          <!-- Netlify Form -->
          <form
            id="catering-form"
            name="catering-request"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="space-y-6"
          >
            <input type="hidden" name="form-name" value="catering-request" />
            <p class="hidden">
              <label
                >Don't fill this out if you're human: <input
                  name="bot-field"
                /></label
              >
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label
                  class="block font-syne text-xs uppercase tracking-wider text-white/80 mb-2"
                  >Your Name</label
                >
                <input
                  type="text"
                  name="name"
                  required
                  class="w-full bg-[#07090E] border border-white/15 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-[#7A1515] transition"
                  placeholder="Sam Smith"
                />
              </div>
              <div>
                <label
                  class="block font-syne text-xs uppercase tracking-wider text-white/80 mb-2"
                  >Email Address</label
                >
                <input
                  type="email"
                  name="email"
                  required
                  class="w-full bg-[#07090E] border border-white/15 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-[#7A1515] transition"
                  placeholder="sam@example.com"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label
                  class="block font-syne text-xs uppercase tracking-wider text-white/80 mb-2"
                  >Phone Number</label
                >
                <input
                  type="tel"
                  name="phone"
                  required
                  class="w-full bg-[#07090E] border border-white/15 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-[#7A1515] transition"
                  placeholder="(555) 000-0000"
                />
              </div>
              <div>
                <label
                  class="block font-syne text-xs uppercase tracking-wider text-white/80 mb-2"
                  >Estimated Event Date</label
                >
                <input
                  type="date"
                  name="date"
                  required
                  class="w-full bg-[#07090E] border border-white/15 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-[#7A1515] transition"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label
                  class="block font-syne text-xs uppercase tracking-wider text-white/80 mb-2"
                  >Approx. Guest Count</label
                >
                <input
                  type="number"
                  name="guests"
                  required
                  class="w-full bg-[#07090E] border border-white/15 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-[#7A1515] transition"
                  placeholder="50"
                />
              </div>
              <div>
                <label
                  class="block font-syne text-xs uppercase tracking-wider text-white/80 mb-2"
                  >Event Location / City</label
                >
                <input
                  type="text"
                  name="location"
                  required
                  class="w-full bg-[#07090E] border border-white/15 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-[#7A1515] transition"
                  placeholder="Seattle, WA"
                />
              </div>
            </div>

            <div>
              <label
                class="block font-syne text-xs uppercase tracking-wider text-white/80 mb-2"
                >Event Details & Occasion</label
              >
              <textarea
                name="details"
                rows="4"
                class="w-full bg-[#07090E] border border-white/15 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-[#7A1515] transition"
                placeholder="Tell us about your party, birthday, or corporate event..."
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-4 bg-[#7A1515] hover:bg-[#921919] text-white font-syne font-bold tracking-wider rounded-xl shadow-xl shadow-[#7A1515]/30 transition transform hover:-translate-y-0.5"
            >
              SUBMIT CATERING REQUEST
            </button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer
    class="py-10 px-6 border-t border-white/10 text-center text-white/50 text-sm"
  >
    <div
      class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4"
    >
      <div class="flex items-center gap-2">
        <img
          src="/SmashItSamLogo.png"
          alt="Logo"
          class="w-8 h-8 rounded-full object-cover"
        />
        <span class="font-syne font-bold text-white text-sm">SMASH-IT SAM</span>
        <span>&copy; {new Date().getFullYear()}</span>
      </div>
      <p class="text-xs uppercase tracking-widest text-[#D1B89F]">
        100% Hand Cut Zabiha Halal
      </p>
    </div>
  </footer>
</Layout>

<script>
  // Netlify Form Submission Handler
  const cateringForm = document.getElementById(
    "catering-form",
  ) as HTMLFormElement;
  const formSuccess = document.getElementById("form-success");

  if (cateringForm) {
    cateringForm.addEventListener("submit", (e) => {
      e.preventDefault();
      const formData = new FormData(cateringForm);

      fetch("/", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams(formData as any).toString(),
      })
        .then(() => {
          cateringForm.reset();
          if (formSuccess) formSuccess.classList.remove("hidden");
        })
        .catch((error) => console.error("Form submission error:", error));
    });
  }
</script>
